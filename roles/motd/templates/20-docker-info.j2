#!/bin/bash

# Colors
CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

# Check if Docker is running
if ! systemctl is-active --quiet docker; then
    printf "  ${RED}⚠  Docker service is not running${NC}\n\n"
    exit 0
fi

# Docker info
CONTAINERS_RUNNING=$(docker ps -q 2>/dev/null | wc -l)
CONTAINERS_TOTAL=$(docker ps -a -q 2>/dev/null | wc -l)
IMAGES=$(docker images -q 2>/dev/null | wc -l)

if [ $CONTAINERS_TOTAL -gt 0 ]; then
    echo "  🐳 Docker Status:"
    echo "  ────────────────────────────────────────────────────────────────────"
    printf "  ${CYAN}%-20s${NC} : ${GREEN}%d${NC} running / %d total\n" "Containers" "$CONTAINERS_RUNNING" "$CONTAINERS_TOTAL"
    printf "  ${CYAN}%-20s${NC} : %d\n" "Images" "$IMAGES"
    
    # List running containers
    if [ $CONTAINERS_RUNNING -gt 0 ]; then
        echo ""
        echo "  Running Containers:"
        docker ps --format "  • {{.Names}} ({{.Status}})" 2>/dev/null
    fi
fi

echo ""
