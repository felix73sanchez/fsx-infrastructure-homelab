upstream ma_tours_api {
    server {{ ansible_default_ipv4.address | default('10.0.0.73') }}:8081;
}
upstream ma_tours_frontend {
    server {{ ansible_default_ipv4.address | default('10.0.0.73') }}:3000;
}
server {
    listen 80;
    server_name {{ app_domains.tours_api }} {{ app_domains.tours_frontend }} {{ ansible_default_ipv4.address | default('10.0.0.73') }};

    location /api/ {
        proxy_pass         http://ma_tours_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
    location /health {
        proxy_pass         http://ma_tours_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
    }
    location / {
        proxy_pass         http://ma_tours_frontend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
    }
}
