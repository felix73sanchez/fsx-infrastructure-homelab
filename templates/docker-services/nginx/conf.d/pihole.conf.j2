server {
    listen 80;
    server_name {{ app_domains.pihole }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ app_domains.pihole }};

    ssl_certificate     {{ letsencrypt_path | default('/etc/letsencrypt') }}/live/{{ ssl_domain }}/fullchain.pem;
    ssl_certificate_key {{ letsencrypt_path | default('/etc/letsencrypt') }}/live/{{ ssl_domain }}/privkey.pem;

    location / {
        proxy_pass         http://{{ ansible_default_ipv4.address | default('10.0.0.73') }}:8053;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
